# Application Configuration
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# Database Configuration (PostgreSQL + PostGIS)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/love_bites_dev
DB_HOST=localhost
DB_PORT=5432
DB_NAME=love_bites_dev
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_MAX=20
DB_POOL_MIN=5
DB_POOL_IDLE=10000

# Redis Cache & Ephemeral Store
REDIS_URL=redis://localhost:6379

# Authentication (JWT Secrets - Phase 2)
JWT_ACCESS_SECRET=your-super-secret-access-key-minimum-32-chars
JWT_REFRESH_SECRET=your-super-secret-refresh-key-minimum-32-chars
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
